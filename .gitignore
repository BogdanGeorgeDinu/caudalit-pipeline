# ─── Terraform ──────────────────────────────────────────────────────────────
# El estado puede contener valores sensibles en claro. El repo es público.
*.tfstate
*.tfstate.*
*.tfstate.backup
.terraform/
crash.log
crash.*.log

# .terraform.lock.hcl SÍ se versiona a propósito: fija las versiones exactas
# de los providers para que cualquier máquina resuelva lo mismo.

# Variables: se versiona solo el ejemplo, nunca los valores reales
*.tfvars
*.tfvars.json
!*.tfvars.example

# Configuración del backend: lleva el nombre real del bucket de estado
backend.hcl

# Planes guardados: binarios que pueden incluir valores de recursos
*.tfplan
tfplan
plan.out

# ─── Credenciales y secretos ────────────────────────────────────────────────
.env
.env.*
!.env.example
credentials
*.pem
*.key
.aws/

# ─── Material de publicación (no es parte del proyecto técnico) ─────────────
# Los borradores de los posts se quedan en local.
post-linkedin.txt
posts-borradores/

# ─── Python ─────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
*.egg-info/

# ─── Empaquetado de Lambdas ─────────────────────────────────────────────────
build/
dist/
*.zip

# ─── Sistema y editores ─────────────────────────────────────────────────────
.DS_Store
.idea/
.vscode/
*.swp

# Artefactos de empaquetado de Lambda
terraform/.build/
